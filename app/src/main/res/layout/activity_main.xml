<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/topTouchInterceptor"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#121212"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivErrorIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_dialog_alert"
            android:layout_marginBottom="16dp"
            android:contentDescription="Error Icon" />

        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Site Unavailable"
            android:textColor="#CF6679"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvErrorDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connection Timed Out. If connecting to a local server on your PC, use your PC's IP address (e.g. http://192.168.1.X:port or http://10.0.2.2:port on emulator) instead of localhost."
            android:textColor="#B0BEC5"
            android:textSize="16sp"
            android:layout_marginBottom="28dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Retry"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnErrorAdmin"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Admin Settings" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnAdmin"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackground"
        android:alpha="0.6"
        android:contentDescription="Admin Settings"
        android:src="@android:drawable/ic_menu_manage" />

    <ImageButton
        android:id="@+id/btnRefresh"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_toLeftOf="@id/btnAdmin"
        android:layout_toStartOf="@id/btnAdmin"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackground"
        android:alpha="0.6"
        android:contentDescription="Reload Page"
        android:src="@android:drawable/ic_popup_sync" />

</RelativeLayout>
